# ========================================================
# LOCAL DEVELOPMENT CONFIGURATION (Default)
# Used when developing locally; connects to "development" database.
# ========================================================
PORT=5001
NODE_ENV=development
DB_NAME=development
MONGO_URI=mongodb+srv://<username>:<password>@english-learning.xslgmb3.mongodb.net/development?retryWrites=true&w=majority
JWT_SECRET=english_learning_jwt_secret_key_2026_very_secure
JWT_EXPIRES_IN=7d
CLIENT_ADMIN_URL=http://localhost:5174
CLIENT_USER_URL=http://localhost:5173

# ========================================================
# PRODUCTION CONFIGURATION (Render / Vercel Hosting)
# Set these in your hosting Dashboard -> Environment Variables.
# Production connects to the live "production" database.
# ========================================================
# NODE_ENV=production
# DB_NAME=production
# MONGO_URI=mongodb+srv://<username>:<password>@english-learning.xslgmb3.mongodb.net/production?retryWrites=true&w=majority
# JWT_SECRET=<generate_a_long_random_secure_secret_for_production>
# JWT_EXPIRES_IN=7d
# CLIENT_ADMIN_URL=https://your-admin-app.vercel.app
# CLIENT_USER_URL=https://your-user-app.vercel.app
